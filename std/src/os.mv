# OS-level operations

fn getcwd() -> str:
    return __intrin.fs_getcwd()

fn chdir(path):
    __intrin.fs_chdir(path)

fn getenv(name) -> str:
    return __intrin.sys_getenv(name)

fn setenv(name, value):
    __intrin.sys_setenv(name, value)

fn listdir(path) -> array:
    return __intrin.fs_listdir(path)

fn mkdir(path):
    __intrin.fs_mkdir(path)

fn exists(path) -> bool:
    return __intrin.fs_exists(path)

fn remove(path):
    __intrin.fs_remove(path)

fn read_file(path) -> str:
    return __intrin.fs_read_file(path)

fn write_file(path, content):
    __intrin.fs_write_file(path, content)

fn append_file(path, content):
    __intrin.fs_append_file(path, content)

fn run(cmd) -> map:
    return __intrin.sys_run(cmd)
