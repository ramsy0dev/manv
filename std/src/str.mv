# Bundled ManV `str` module.
#
# Why this file exists:
# - Provides a flat, importable `str` module for string operations.
# - Exposes comprehensive string manipulation helpers in ManV source.
# - All operations use __intrin.str_* intrinsics for correctness.

fn from_value(x) -> str:
    "Converts any value to its string representation."
    return __intrin.core_str(x)

fn repr_value(x) -> str:
    "Returns the debug/repr string of a value."
    return __intrin.core_repr(x)

fn length(s: str) -> int:
    "Returns the number of characters in the string."
    return __intrin.core_len(s)

fn upper(s: str) -> str:
    "Converts all characters to uppercase."
    return __intrin.str_upper(s)

fn lower(s: str) -> str:
    "Converts all characters to lowercase."
    return __intrin.str_lower(s)

fn strip(s: str) -> str:
    "Removes leading and trailing whitespace."
    return __intrin.str_trim(s)

fn lstrip(s: str) -> str:
    "Removes leading whitespace."
    return __intrin.str_lstrip(s)

fn rstrip(s: str) -> str:
    "Removes trailing whitespace."
    return __intrin.str_rstrip(s)

fn split(s: str, sep: str) -> array:
    "Splits the string by separator, returns an array of substrings."
    return __intrin.str_split(s, sep)

fn split_lines(s: str) -> array:
    "Splits the string by newline characters."
    return __intrin.str_split(s, "\n")

fn join(sep: str, items: array) -> str:
    "Joins an array of strings with the separator."
    return __intrin.str_join(sep, items)

fn replace(s: str, old: str, new: str) -> str:
    "Replaces all occurrences of old with new."
    return __intrin.str_replace(s, old, new)

fn startswith(s: str, prefix: str) -> bool:
    "Returns true if the string starts with the given prefix."
    return __intrin.str_startswith(s, prefix)

fn endswith(s: str, suffix: str) -> bool:
    "Returns true if the string ends with the given suffix."
    return __intrin.str_endswith(s, suffix)

fn contains(s: str, sub: str) -> bool:
    "Returns true if the string contains the given substring."
    return __intrin.str_contains(s, sub)

fn find(s: str, sub: str) -> int:
    "Returns the index of the first occurrence of sub, or -1 if not found."
    return __intrin.str_find(s, sub)

fn char_at(s: str, idx: int) -> str:
    "Returns the character at the given index."
    return __intrin.str_char_at(s, idx)

fn slice(s: str, start: int, stop: int) -> str:
    "Returns the substring from start to stop."
    return __intrin.str_slice(s, start, stop)

fn to_chars(s: str) -> array:
    "Returns an array of individual characters."
    return __intrin.str_to_chars(s)

fn concat(a: str, b: str) -> str:
    "Concatenates two strings."
    return __intrin.str_concat(a, b)

fn repeat(s: str, n: int) -> str:
    "Repeats the string n times."
    return __intrin.str_repeat(s, n)

fn is_empty(s: str) -> bool:
    "Returns true if the string has zero length."
    return __intrin.str_is_empty(s)

fn pad_left(s: str, width: int, fill: str) -> str:
    "Right-justifies the string in a field of the given width."
    return __intrin.str_pad_left(s, width, fill)

fn pad_right(s: str, width: int, fill: str) -> str:
    "Left-justifies the string in a field of the given width."
    return __intrin.str_pad_right(s, width, fill)

fn to_int(s: str) -> int:
    "Parses the string as a decimal integer."
    return __intrin.str_to_int(s)

fn to_float(s: str) -> float:
    "Parses the string as a float."
    return __intrin.str_to_float(s)

fn format(template: str, args: array) -> str:
    "Formats template by replacing {0}, {1}, ... with args."
    return __intrin.str_format(template, args)
