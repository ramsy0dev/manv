# JSON parsing and serialization

fn parse(s) -> any:
    return __intrin.json_parse(s)

fn stringify(obj) -> str:
    return __intrin.json_stringify(obj)

fn pretty(obj, indent) -> str:
    return __intrin.json_stringify_pretty(obj, indent)

fn get_str(obj, key) -> any:
    if __intrin.core_map_has_key(obj, key):
        let val = obj[key]
        if isinstance(val, str):
            return val
    return none

fn get_int(obj, key) -> any:
    if __intrin.core_map_has_key(obj, key):
        let val = obj[key]
        if isinstance(val, int):
            return val
    return none

fn get_array(obj, key) -> any:
    if __intrin.core_map_has_key(obj, key):
        let val = obj[key]
        if isinstance(val, array):
            return val
    return none

fn get_map(obj, key) -> any:
    if __intrin.core_map_has_key(obj, key):
        let val = obj[key]
        if isinstance(val, map):
            return val
    return none
