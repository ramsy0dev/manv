# Bundled ManV `io` module.
#
# Why this file exists:
# - Provides file I/O and standard stream operations.
# - All operations use __intrin.fs_* and __intrin.io_* for correctness.

fn print_line(text: str):
    "Prints text followed by a newline to stdout."
    print(text)

fn read_line() -> str:
    "Reads a line from stdin, stripping the trailing newline."
    return __intrin.io_read_line()

fn read_file(path: str) -> str:
    "Reads the entire contents of a file as a UTF-8 string."
    return __intrin.fs_read_text(path)

fn write_file(path: str, content: str):
    "Writes content to a file, creating or overwriting it."
    __intrin.fs_write_text(path, content)

fn append_file(path: str, content: str):
    "Appends content to a file (reads existing content first, then writes combined)."
    let existing = ""
    if exists(path):
        existing = read_file(path)
    __intrin.fs_write_text(path, __intrin.str_concat(existing, content))

fn exists(path: str) -> bool:
    "Returns true if the file or directory exists."
    return __intrin.fs_exists(path)

fn mkdir(path: str, parents: bool):
    "Creates a directory. If parents is true, creates intermediate directories."
    __intrin.fs_mkdir(path, parents)

fn list_dir(path: str) -> array:
    "Lists the names of entries in a directory."
    return __intrin.fs_list(path)

fn remove(path: str):
    "Removes a file or empty directory."
    __intrin.fs_remove(path)
