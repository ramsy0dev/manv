# Option[T] — Rust-inspired optional value

class Option:
    let NONE_TAG: str = "None"
    let SOME_TAG: str = "Some"

    fn __init__(self, tag, value):
        self.tag = tag
        self.value = value

    fn is_some(self) -> bool:
        return self.tag == Option.SOME_TAG

    fn is_none(self) -> bool:
        return self.tag == Option.NONE_TAG

    fn unwrap(self) -> any:
        if self.is_none():
            raise ValueError("called unwrap() on a None value")
        return self.value

    fn unwrap_or(self, default) -> any:
        if self.is_none():
            return default
        return self.value

    fn unwrap_or_else(self, fn_) -> any:
        if self.is_none():
            return fn_()
        return self.value

    fn map(self, fn_) -> Option:
        if self.is_none():
            return self
        return Some(fn_(self.value))

    fn and_then(self, fn_) -> Option:
        if self.is_none():
            return self
        return fn_(self.value)

    fn or_else(self, fn_) -> Option:
        if self.is_some():
            return self
        return fn_()

    fn filter(self, fn_) -> Option:
        if self.is_none():
            return self
        if fn_(self.value):
            return self
        return None_()

    fn __repr__(self) -> str:
        if self.is_none():
            return "None"
        return __intrin.str_concat("Some(", __intrin.str_concat(__intrin.core_repr(self.value), ")"))

    fn __eq__(self, other) -> bool:
        if not isinstance(other, Option):
            return false
        if self.tag != other.tag:
            return false
        if self.is_none():
            return true
        return self.value == other.value

fn Some(value) -> Option:
    return Option(Option.SOME_TAG, value)

fn None_() -> Option:
    return Option(Option.NONE_TAG, none)
