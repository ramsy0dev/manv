# Random number generation

fn seed(s):
    __intrin.rand_seed(s)

fn rand_int(lo, hi) -> int:
    return __intrin.rand_int(lo, hi)

fn rand_float() -> float:
    return __intrin.rand_float()

fn choice(arr) -> any:
    if len(arr) == 0:
        raise ValueError("choice from empty array")
    let idx = __intrin.rand_int(0, len(arr) - 1)
    return arr[idx]

fn shuffle(arr) -> array:
    let result = []
    for item in arr:
        __intrin.core_array_push(result, item)
    let n = len(result)
    let i = n - 1
    while i > 0:
        let j = __intrin.rand_int(0, i)
        let tmp = result[i]
        result[i] = result[j]
        result[j] = tmp
        i = i - 1
    return result

class Random:
    fn __init__(self, seed_val):
        self.seed_val = seed_val
        __intrin.rand_seed(seed_val)

    fn next_int(self, lo, hi) -> int:
        return __intrin.rand_int(lo, hi)

    fn next_float(self) -> float:
        return __intrin.rand_float()

    fn choice(self, arr) -> any:
        if len(arr) == 0:
            raise ValueError("choice from empty array")
        let idx = __intrin.rand_int(0, len(arr) - 1)
        return arr[idx]
